# Conflict-free replicated data types and the clocks that stamp them: a thin
# mirror of the `merge-machines` crate.
#
# Every state merges commutatively, associatively and idempotently, so replicas
# converge without a coordinator and without ordering their messages. Nothing
# here talks to a network or reads a clock: the caller owns the transport, the
# replica ids, the OrSet tags and every wall-clock reading.
#
# Elements, values, replica ids, tags and stamps are unsigned 64-bit Integers.
# A non-Integer raises TypeError; an Integer outside 0..2**64-1 raises
# RangeError. A refusal is a symbol, never an exception, and changes nothing.
module MergeMachines
  VERSION: String

  type refusal = :full | :overflow | :exhausted | :mismatch
               | :truncated | :wrong_structure | :wrong_shape | :malformed

  # The core's `HybridTimestamp`. `wall_ns` is an event-time stamp in
  # nanoseconds since the Unix epoch, not a monotonic instant.
  class Timestamp < ::Data
    attr_reader wall_ns: Integer
    attr_reader counter: Integer
    def self.new: (Integer wall_ns, Integer counter) -> instance
                | (wall_ns: Integer, counter: Integer) -> instance
  end

  # The core's `Entry`: one replica's count in a GCounter.
  class Entry < ::Data
    attr_reader replica: Integer
    attr_reader count: Integer
    def self.new: (Integer replica, Integer count) -> instance
                | (replica: Integer, count: Integer) -> instance
  end

  # The core's `Tag`: which add an OrSet remove is talking about.
  class Tag < ::Data
    attr_reader replica: Integer
    attr_reader counter: Integer
    def self.new: (Integer replica, Integer counter) -> instance
                | (replica: Integer, counter: Integer) -> instance
  end

  # The core's `Tagged`: an OrSet element and the Tag it came under. TypeError
  # unless `tag` is a Tag.
  class Tagged < ::Data
    attr_reader element: Integer
    attr_reader tag: Tag
    def self.new: (Integer element, Tag tag) -> instance
                | (element: Integer, tag: Tag) -> instance
  end

  # A counter that only grows, counted separately by each replica.
  class GCounter
    # `GCounter::<replicas>::new()`. RangeError unless `replicas` is 4, 8, 16
    # or 32.
    def self.new: (Integer replicas) -> instance

    # Reads an `encoded` frame at the replica count it names. RangeError for a
    # frame the core refuses (the message names the refusal) or a replica
    # count outside 4, 8, 16, 32.
    def self.decode: (String frame) -> instance

    def replicas: () -> Integer

    # Adds `by` to `replica`'s count. Zero is honoured and claims no slot.
    def increment: (Integer replica, Integer by) -> (:incremented | :full | :overflow)

    # What `replica` has added, zero if it holds no slot here.
    def count: (Integer replica) -> Integer

    def value: () -> Integer
    def entries: () -> Array[Entry]

    # Folds `other` in whole or not at all. TypeError for anything but a
    # GCounter of the same replica count.
    def merge: (GCounter other) -> (:merged | :full)

    def ==: (untyped other) -> bool
    def encoded: () -> String
    def inspect: () -> String
  end

  # A counter replicas can both raise and lower, from two that only grow.
  class PNCounter
    # `PNCounter::<replicas>::new()`. RangeError unless `replicas` is 4, 8, 16
    # or 32.
    def self.new: (Integer replicas) -> instance

    # RangeError for a frame the core refuses or an unsupported replica count.
    def self.decode: (String frame) -> instance

    def replicas: () -> Integer
    def increment: (Integer replica, Integer by) -> (:incremented | :full | :overflow)
    def decrement: (Integer replica, Integer by) -> (:decremented | :full | :overflow)

    # Everything added, minus everything taken away, which may be negative.
    def value: () -> Integer

    def added: () -> Integer
    def removed: () -> Integer

    # Folds `other` in whole or not at all. TypeError for anything but a
    # PNCounter of the same replica count.
    def merge: (PNCounter other) -> (:merged | :full)

    def ==: (untyped other) -> bool
    def encoded: () -> String
    def inspect: () -> String
  end

  # One value, held by whichever write was stamped last, with the replica id as
  # the tie-break. Built with an Integer stamp it is the core's
  # `LwwRegister<u64, u64>`; with a Timestamp, `LwwRegister<u64,
  # HybridTimestamp>`. A stamp or register of the other kind is a TypeError.
  class LwwRegister
    def self.new: (Integer value, Integer | Timestamp stamp, Integer replica) -> instance

    # RangeError for a frame the core refuses, including one naming another
    # kind of stamp than the two supported.
    def self.decode: (String frame) -> instance

    # `:superseded` is a write a later one beats: the register working, not a
    # refusal. `:duplicate` is the write already held. `:mismatch` is the same
    # stamp and replica with another value.
    def set: (Integer value, Integer | Timestamp stamp, Integer replica)
           -> (:written | :duplicate | :superseded | :mismatch)

    def value: () -> Integer
    def stamp: () -> (Integer | Timestamp)
    def replica: () -> Integer

    # TypeError for anything but a register of the same kind of stamp.
    def merge: (LwwRegister other) -> (:merged | :mismatch)

    def ==: (untyped other) -> bool
    def encoded: () -> String
    def inspect: () -> String
  end

  # A set of Integers nothing is ever taken out of.
  class GSet
    # `GSet::<u64, capacity>::new()`. RangeError unless `capacity` is 64, 256
    # or 1024.
    def self.new: (Integer capacity) -> instance

    # RangeError for a frame the core refuses or an unsupported capacity.
    def self.decode: (String frame) -> instance

    def capacity: () -> Integer
    def insert: (Integer element) -> (:inserted | :duplicate | :full)
    def include?: (Integer element) -> bool

    # The core's `iter`, collected, in no particular order.
    def to_a: () -> Array[Integer]

    def size: () -> Integer
    def empty?: () -> bool

    # TypeError for anything but a GSet of the same capacity.
    def merge: (GSet other) -> (:merged | :full)

    def ==: (untyped other) -> bool
    def encoded: () -> String
    def inspect: () -> String
  end

  # A set of Integers elements can leave, where a concurrent add survives a
  # remove. The caller picks every add's Tag. A tombstone lives on the add it
  # removes, so `capacity` bounds the adds and a remove never refuses.
  class OrSet
    # `OrSet::<u64, capacity>::new()`. RangeError unless `capacity` is 64, 256
    # or 1024.
    def self.new: (Integer capacity) -> instance

    # RangeError for a frame the core refuses or an unsupported capacity.
    def self.decode: (String frame) -> instance

    def capacity: () -> Integer

    # `:duplicate` is the same tag adding the same element again, tombstoned or
    # not. `:mismatch` is a tag that already added another element. TypeError
    # unless `tag` is a Tag.
    def add: (Integer element, Tag tag) -> (:added | :duplicate | :full | :mismatch)

    def remove: (Integer element) -> (:removed | :not_held)
    def include?: (Integer element) -> bool

    # The core's `iter`, collected: live elements, each once.
    def to_a: () -> Array[Integer]

    def size: () -> Integer
    def empty?: () -> bool
    def adds: () -> Array[Tagged]
    def removes: () -> Array[Tag]

    # TypeError for anything but an OrSet of the same capacity.
    def merge: (OrSet other) -> (:merged | :full | :mismatch)

    def ==: (untyped other) -> bool
    def encoded: () -> String
    def inspect: () -> String
  end

  # Lamport's counter. Its stamps are protocol numbers peers compare, not
  # handles.
  class LogicalClock
    def self.new: () -> instance

    # RangeError for a frame the core refuses.
    def self.decode: (String frame) -> instance

    # The last stamp this clock issued.
    def now: () -> Integer

    def tick: () -> (Integer | :exhausted)
    def observe: (Integer observed) -> (Integer | :exhausted)
    def ==: (untyped other) -> bool
    def encoded: () -> String
    def inspect: () -> String
  end

  # A wall-clock reading paired with a counter, never going backwards. The
  # caller passes every `wall_ns` (Process.clock_gettime(Process::CLOCK_REALTIME,
  # :nanosecond)); no deadline may be derived from it.
  class HybridClock
    def self.new: () -> instance

    # RangeError for a frame the core refuses.
    def self.decode: (String frame) -> instance

    # The last timestamp this clock issued.
    def last: () -> Timestamp

    def tick: (Integer wall_ns) -> (Timestamp | :exhausted)

    # TypeError unless `observed` is a Timestamp.
    def observe: (Integer wall_ns, Timestamp observed) -> (Timestamp | :exhausted)

    def ==: (untyped other) -> bool
    def encoded: () -> String
    def inspect: () -> String
  end

  # Private native hooks each Data value's `initialize` validates its fields
  # through: nil, or TypeError/RangeError.
  private def self.__timestamp: (Integer wall_ns, Integer counter) -> nil
  private def self.__entry: (Integer replica, Integer count) -> nil
  private def self.__tag: (Integer replica, Integer counter) -> nil
  private def self.__tagged: (Integer element, Tag tag) -> nil
end
